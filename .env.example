# ==========================================
# TenderSense Environment Configuration
# ==========================================
ENVIRONMENT=development
DEBUG=true

# ====================================================================
# RECOMMENDED: 100% FREE OPEN-SOURCE API PROVIDERS (No credit card)
# ====================================================================
# 1. Groq (Free high-speed open source LLMs: Llama 3.3 70B, Llama 3.1 8B, Compound)
# Get your free key in 30 seconds at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# 2. Hugging Face (Free open source embeddings: all-MiniLM-L6-v2, bge-small)
# Get your free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ====================================================================
# OPTIONAL: COMMERCIAL PAID PROVIDERS (Leave blank if using free)
# ====================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ====================================================================
# PIPELINE PROVIDER SELECTION
# ====================================================================
# Embedding Provider: 'local' (built-in 100% offline), 'huggingface' (free API), or 'openai'
EMBEDDING_PROVIDER=huggingface

# LLM Summary Provider: 'groq' (free Llama 3.1), 'mock' (built-in deterministic), 'openai', or 'anthropic'
LLM_PROVIDER=groq

